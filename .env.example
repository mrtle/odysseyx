# Claude API key. Without it OdysseusX runs in demo mode with an offline,
# heuristic coach. Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional: override the model (default: claude-opus-5-5).
# ODYSSEUSX_MODEL=claude-opus-5-5

# Optional: force "live" or "demo" mode regardless of credentials.
# ODYSSEUSX_MODE=demo

# Optional: disable server-side refusal fallbacks (needed when routing
# through a gateway or cloud platform that doesn't accept the parameter).
# ODYSSEUSX_DISABLE_FALLBACKS=1

# Optional: rate limits for the AI routes, in calls per minute (0 = off).
# Live mode, per client (default 20):
# ODYSSEUSX_RATE_LIMIT_PER_MINUTE=20
# Demo mode, per client (default 60; the offline coach costs server CPU):
# ODYSSEUSX_DEMO_RATE_LIMIT_PER_MINUTE=60
# All clients together, per mode (default 10 x the per-client limit):
# ODYSSEUSX_GLOBAL_RATE_LIMIT_PER_MINUTE=200

# Optional: how many proxies in front of the app append to X-Forwarded-For
# (default 1: use the address the nearest proxy saw). Set 0 when `next start`
# is exposed directly (forwarded headers are then ignored and all clients
# share one bucket). On Vercel, x-vercel-forwarded-for is used automatically.
# ODYSSEUSX_TRUSTED_PROXY_HOPS=1
